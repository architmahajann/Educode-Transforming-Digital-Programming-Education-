        <script id="room-questions" type="application/json"><%- JSON.stringify(questionStatements || []) %></script>
        <script>
        // Add this code to your admin.js file
        document.addEventListener('DOMContentLoaded', function () {
            const socket = window.socket || io(); // Reuse shared socket
            window.socket = socket;
            const adminPanel = document.getElementById('tabalert');
            const setBtn = document.getElementById('setAllottedQuestionBtn');
            const select = document.getElementById('allottedQuestionSelect');
            const roomId = window.location.toString().split('admin/')[1].split('/')[0];
                        // Provide full questions to JS safely via JSON script tag
                        try {
                            const jsonEl = document.getElementById('room-questions');
                            window.roomQuestions = JSON.parse((jsonEl && jsonEl.textContent) || '[]');
                        } catch (_) { window.roomQuestions = []; }

            function updateSelectedCount(){
                try {
                    const countEl = document.getElementById('selectedCount');
                    if (!countEl || !select) return;
                    const count = Array.from(select.options).filter(o => o.selected && o.value !== '').length;
                    countEl.textContent = `${count} selected`;
                } catch(_) {}
            }

            if (setBtn && select) {
                // Initialize selected count on load
                updateSelectedCount();
                // Update on change
                select.addEventListener('change', updateSelectedCount);
                setBtn.addEventListener('click', async function(){
                    try {
                        const selected = Array.from(select.options).filter(o => o.selected && o.value !== '').map(o => parseInt(o.value, 10)).filter(n => !Number.isNaN(n));
                        if (selected.length === 0) return;
                        const questions = selected.map(i => (window.roomQuestions && window.roomQuestions[i]) || '').filter(Boolean);
                        if (questions.length === 0) return;
                        // Persist on server (supports multiple)
                        await axios.post('/api/v1/setallottedquestion', { roomId, questions });
                        // Broadcast live to students (multiple)
                        socket.emit('admin-set-allotted-questions', { roomId, questions });
                        try { tata.success('Allotted questions updated'); } catch(_) {}
                    } catch (e) {
                        console.error('Failed to set allotted questions', e);
                        try { tata.error('Failed to set allotted questions'); } catch(_) {}
                    }
                });
            }

            // Update the visibility change event listener in admin.js
            socket.on('visibility-change', ({ username, roomId, action, url }) => {
                // Create a new div element for the visibility change message
                const visibilityChangeElement = document.createElement('div');
                visibilityChangeElement.classList.add('visibility-change-message'); // Add CSS class

                // Get the current time
                const currentTime = new Date();
                const formattedTime = currentTime.toLocaleTimeString(); // Format the time as per your requirement

                // Set the content of the message with the timestamp
                visibilityChangeElement.textContent = `[${formattedTime}] User ${username} in room ${roomId} ${action}`;

                // Append the visibility change message to the admin panel
                adminPanel.appendChild(visibilityChangeElement);

                // Scroll to the bottom of the admin panel to show the latest message
                adminPanel.scrollTop = adminPanel.scrollHeight;
            });

        });


    </script>





