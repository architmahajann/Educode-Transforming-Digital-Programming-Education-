<!doctype html>
<html lang="en">

<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/stylesheets/codemirror.css">
    <link rel="stylesheet" href="/stylesheets/dracula.css">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">

    <title>Code Report & Grading!</title>
    <style>
        /* Page layout fixes */
        body { background:#f5f6fa; }
        #headcode { padding-bottom: 90px; } /* prevent overlap with fixed footer */
        .container-narrow { max-width: 1280px; margin: 0 auto; }
        .controls-bar { gap: 10px; }

        .grading-panel {
            background: #f8f9fa;
            border: 2px solid #dee2e6;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
        }
        .rank-badge {
            font-size: 24px;
            font-weight: bold;
            padding: 10px 20px;
            border-radius: 50%;
            display: inline-block;
            min-width: 60px;
            text-align: center;
        }
        .rank-1 { background: linear-gradient(135deg, #FFD700, #FFA500); color: white; }
        .rank-2 { background: linear-gradient(135deg, #C0C0C0, #808080); color: white; }
        .rank-3 { background: linear-gradient(135deg, #CD7F32, #8B4513); color: white; }
        .rank-other { background: linear-gradient(135deg, #6c757d, #495057); color: white; }
        .graded { border-left: 5px solid #28a745; }
        .not-graded { border-left: 5px solid #ffc107; }
        .student-card {
            transition: all 0.3s;
            margin-bottom: 30px;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            background: #ffffff;
            overflow: hidden;
        }
        .student-card:hover {
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        /* Code editor sizing */
        .code-editor .CodeMirror { height: 420px; border: 1px solid #e9ecef; border-radius: 6px; }
        @media (max-width: 992px) { .code-editor .CodeMirror { height: 360px; } }
        @media (max-width: 576px) { .code-editor .CodeMirror { height: 300px; } }
    </style>
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-light bg-light sticky-top shadow-sm">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
            <div class="collapse navbar-collapse d-flex mx-auto controls-bar" id="navbarSupportedContent">
                <button id='calculateRanks' type="button" class="btn btn-success">📊 Calculate Ranks</button>
                <button id='viewLeaderboard' type="button" class="btn btn-info text-white">🏆 View Leaderboard</button>
                <button id='pdf' type="button" class="btn btn-primary">📄 Download PDF</button>
                <button id='saveAllGrades' type="button" class="btn btn-warning">💾 Save All Grades</button>
            </div>
        </div>
    </nav>
    <div class="container-fluid container-narrow" id='headcode'>


        <p class="fs-4 fw-bold text-center">
            Labname:
            <%= labname %>
        </p>

        <div class="row g-4" id='alldata'>

        </div>
    </div>

    <footer style="position: fixed; bottom: 0; width: 100%; background-color: #1a1a1a; color: white; text-align: center; padding: 5px;">
        &copy; Archit Mahajan And Team
    </footer>




    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.8.0/html2pdf.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
    <script type="text/javascript" src="/javascripts/codemirrorlib/codemirror.min.js"></script>
    <script type="text/javascript" src="/javascripts/codemirrorlib/python.min.js"></script>
    <script type="text/javascript" src="/javascripts/codemirrorlib/clike.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/0.21.1/axios.min.js"></script>
    <script src="/javascripts/tata.js"></script>
    <script>
        let roomId, adminCode;
        let studentsData = [];

        window.onload = function() {
            adminCode = window.location.toString().split('/')[5];
            roomId = window.location.toString().split('/')[4];
            loadSubmissions();
        }

        function loadSubmissions() {
            axios.post('/api/v1/getcode', { roomId })
                .then((res) => {
                    if (res.data.status === 200) {
                        studentsData = res.data.data.code;
                        
                        if (studentsData.length === 0) {
                            document.getElementById('alldata').innerHTML = '<div class="col-12 text-center mt-5"><p class="fs-5">No student submissions found for this room.</p></div>';
                            return;
                        }
                        
                        renderSubmissions();
                    }
                })
                .catch((error) => {
                    console.error('Error fetching code:', error);
                    tata.error('Error', 'Error loading student submissions. Please try again.', {
                        animate: 'fade',
                        position: 'tm'
                    });
                });
        }

        function renderSubmissions() {
            document.getElementById('alldata').innerHTML = '';
            
            for (let i = 0; i < studentsData.length; i++) {
                const student = studentsData[i];
                const lastActive = student.lastActive ? new Date(student.lastActive).toLocaleString() : 'Never';
                const isGraded = student.marks !== null && student.marks !== undefined;
                const gradedClass = isGraded ? 'graded' : 'not-graded';
                // Create a safe DOM id from username
                const safeId = `editor-${(student.username || 'student').toString().replace(/[^a-zA-Z0-9_-]/g, '_')}`;
                
                // Rank badge
                let rankBadge = '';
                if (student.rank) {
                    const rankClass = student.rank === 1 ? 'rank-1' : student.rank === 2 ? 'rank-2' : student.rank === 3 ? 'rank-3' : 'rank-other';
                    rankBadge = `<span class="rank-badge ${rankClass}">#${student.rank}</span>`;
                }
                
                // Status badge
                const statusBadge = `<span class="badge ${isGraded ? 'bg-success' : 'bg-warning text-dark'}">${isGraded ? '✓ Graded' : '⏳ Pending'}</span>`;
                
                                let html = `
                                        <div class="col-12">
                                            <div class="student-card ${gradedClass}">
                                                <div class="grading-panel">
                                                    <div class="row align-items-center">
                                                        <div class="col-lg-4 col-md-5 col-12 mb-3 mb-md-0">
                                                            <p class="fs-5 fw-bold mb-1 d-flex align-items-center" style="gap:10px;">${rankBadge} <span>${student.username}</span></p>
                                                            <small class="text-muted d-block">Last Active: ${lastActive}</small>
                                                            <div class="mt-2">${statusBadge}</div>
                                                        </div>
                                                        <div class="col-lg-8 col-md-7 col-12">
                                                            <div class="row g-2">
                                                                <div class="col-6 col-md-3">
                                                                    <label class="form-label fw-bold">Marks</label>
                                                                    <input type="number" class="form-control marks-input" 
                                                                                 data-username="${student.username}" 
                                                                                 value="${student.marks || ''}" 
                                                                                 min="0" max="${student.maxMarks || 100}" 
                                                                                 placeholder="0-${student.maxMarks || 100}">
                                                                </div>
                                                                <div class="col-6 col-md-2">
                                                                    <label class="form-label fw-bold">Max</label>
                                                                    <input type="number" class="form-control maxmarks-input" 
                                                                                 data-username="${student.username}" 
                                                                                 value="${student.maxMarks || 100}" 
                                                                                 min="1">
                                                                </div>
                                                                <div class="col-12 col-md-5">
                                                                    <label class="form-label fw-bold">Feedback</label>
                                                                    <input type="text" class="form-control feedback-input" 
                                                                                 data-username="${student.username}" 
                                                                                 value="${student.feedback || ''}" 
                                                                                 placeholder="Optional comments">
                                                                </div>
                                                                <div class="col-12 col-md-2 d-grid">
                                                                    <label class="form-label d-none d-md-block">&nbsp;</label>
                                                                    <button class="btn btn-success save-grade-btn" data-username="${student.username}">💾 Save</button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                                        <div class="code-editor px-2 pb-3">
                                                                            <textarea id="${safeId}" name="code"></textarea>
                                                </div>
                                            </div>
                                        </div>
                                `;
                
                document.getElementById('alldata').insertAdjacentHTML('beforeend', html);
                
                // Initialize CodeMirror
                const textinput = document.getElementById(safeId);
                let editor = CodeMirror.fromTextArea(textinput, {
                    lineNumbers: true,
                    tabSize: 2,
                    readOnly: true,
                    mode: 'text/x-c++src',
                    theme: 'dracula',
                });
                editor.setSize('100%', '100%');
                editor.setValue(student.code || '// No code submitted');
            }
            
            // Add event listeners for save buttons
            document.querySelectorAll('.save-grade-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const username = this.getAttribute('data-username');
                    saveGrade(username);
                });
            });
        }

        function saveGrade(username) {
            const marks = parseFloat(document.querySelector(`.marks-input[data-username="${username}"]`).value);
            const maxMarks = parseFloat(document.querySelector(`.maxmarks-input[data-username="${username}"]`).value) || 100;
            const feedback = document.querySelector(`.feedback-input[data-username="${username}"]`).value;
            
            if (isNaN(marks) || marks < 0 || marks > maxMarks) {
                tata.error('Invalid Marks', `Please enter marks between 0 and ${maxMarks}`, {
                    animate: 'fade',
                    position: 'tm'
                });
                return;
            }
            
            axios.post('/api/v1/gradesubmission', {
                roomId,
                username,
                marks,
                maxMarks,
                feedback,
                gradedBy: 'Admin' // You can pass actual admin name if available
            })
            .then(res => {
                if (res.data.status === 200) {
                    tata.success('Saved', `Marks saved for ${username}`, {
                        animate: 'fade',
                        position: 'tm',
                        duration: 2000
                    });
                    // Update local data
                    const studentIndex = studentsData.findIndex(s => s.username === username);
                    if (studentIndex !== -1) {
                        studentsData[studentIndex] = res.data.data;
                    }
                }
            })
            .catch(error => {
                console.error('Error saving grade:', error);
                tata.error('Error', 'Failed to save grade. Please try again.', {
                    animate: 'fade',
                    position: 'tm'
                });
            });
        }

        document.getElementById('saveAllGrades').addEventListener('click', () => {
            let savedCount = 0;
            const promises = [];
            
            document.querySelectorAll('.marks-input').forEach(input => {
                const username = input.getAttribute('data-username');
                const marks = parseFloat(input.value);
                
                if (!isNaN(marks)) {
                    const maxMarks = parseFloat(document.querySelector(`.maxmarks-input[data-username="${username}"]`).value) || 100;
                    const feedback = document.querySelector(`.feedback-input[data-username="${username}"]`).value;
                    
                    const promise = axios.post('/api/v1/gradesubmission', {
                        roomId,
                        username,
                        marks,
                        maxMarks,
                        feedback,
                        gradedBy: 'Admin'
                    });
                    
                    promises.push(promise);
                    savedCount++;
                }
            });
            
            Promise.all(promises)
                .then(() => {
                    tata.success('Success', `Saved ${savedCount} grades successfully!`, {
                        animate: 'fade',
                        position: 'tm',
                        duration: 3000
                    });
                    loadSubmissions(); // Reload to show updated data
                })
                .catch(error => {
                    console.error('Error saving all grades:', error);
                    tata.error('Error', 'Some grades failed to save. Please try again.', {
                        animate: 'fade',
                        position: 'tm'
                    });
                });
        });

        document.getElementById('calculateRanks').addEventListener('click', () => {
            axios.post('/api/v1/calculateranks', { roomId })
                .then(res => {
                    if (res.data.status === 200) {
                        tata.success('Success', 'Ranks calculated successfully!', {
                            animate: 'fade',
                            position: 'tm',
                            duration: 2000
                        });
                        loadSubmissions(); // Reload to show ranks
                    }
                })
                .catch(error => {
                    console.error('Error calculating ranks:', error);
                    tata.error('Error', 'Failed to calculate ranks. Make sure students have marks assigned.', {
                        animate: 'fade',
                        position: 'tm'
                    });
                });
        });

        document.getElementById('viewLeaderboard').addEventListener('click', () => {
            axios.post('/api/v1/leaderboard', { roomId })
                .then(res => {
                    if (res.data.status === 200) {
                        const leaderboard = res.data.data;
                        
                        if (leaderboard.length === 0) {
                            tata.info('No Data', 'No graded submissions yet. Grade some students first!', {
                                animate: 'fade',
                                position: 'tm'
                            });
                            return;
                        }
                        
                        let html = '<h3 class="text-center mb-3">🏆 Leaderboard 🏆</h3><table class="table table-striped table-hover"><thead class="table-dark"><tr><th>Rank</th><th>Username</th><th>Marks</th><th>Percentage</th><th>Feedback</th></tr></thead><tbody>';
                        
                        leaderboard.forEach(student => {
                            const percentage = ((student.marks / student.maxMarks) * 100).toFixed(2);
                            const rankIcon = student.rank === 1 ? '🥇' : student.rank === 2 ? '🥈' : student.rank === 3 ? '🥉' : '';
                            html += `<tr>
                                <td><strong>${rankIcon} ${student.rank}</strong></td>
                                <td>${student.username}</td>
                                <td>${student.marks}/${student.maxMarks}</td>
                                <td><span class="badge bg-primary">${percentage}%</span></td>
                                <td>${student.feedback || '-'}</td>
                            </tr>`;
                        });
                        
                        html += '</tbody></table>';
                        
                        // Create modal
                        const modal = `
                            <div class="modal fade" id="leaderboardModal" tabindex="-1">
                                <div class="modal-dialog modal-lg">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Leaderboard</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">${html}</div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                        
                        // Remove existing modal if any
                        const existingModal = document.getElementById('leaderboardModal');
                        if (existingModal) existingModal.remove();
                        
                        document.body.insertAdjacentHTML('beforeend', modal);
                        const modalElement = new bootstrap.Modal(document.getElementById('leaderboardModal'));
                        modalElement.show();
                    }
                })
                .catch(error => {
                    console.error('Error fetching leaderboard:', error);
                    tata.error('Error', 'Failed to fetch leaderboard.', {
                        animate: 'fade',
                        position: 'tm'
                    });
                });
        });

        document.getElementById('pdf').addEventListener('click', () => {
            var element = document.getElementById('headcode');
            var opt = {
                margin: [0, 0, 0, 1],
                filename: 'student-submissions-report.pdf',
                image: { type: 'jpeg', quality: 1 },
                html2canvas: { scale: 2 },
                jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' }
            };
            html2pdf(element, opt);
        });
    </script>

</body>

</html>
