                </div>
                <div class="vidss" id="tabalerts">
                    <div class="activity-header">
                        📊 Admin Activity Feed
                    </div>
                    <div id="adminActivityFeed">
                        <div class="admin-activity-item" style="text-align: center; color: #999; font-style: italic; padding: 20px;">
