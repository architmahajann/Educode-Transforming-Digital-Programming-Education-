    <footer style="position: fixed; bottom: 0; width: 100%; background-color: #1a1a1a; color: white; text-align: center; padding: 5px;">
        &copy; Archit Mahajan And Team
    </footer>

    <!-- Display test time limit as minutes -->
    <script>
        // Fetching test time limit from backend
        const testTimeLimit = Number("<%= (typeof testTimeLimit !== 'undefined' && testTimeLimit !== null && testTimeLimit !== '') ? testTimeLimit : 0 %>");

        // Only set up timer if there's a time limit (test mode)
        if (testTimeLimit > 0) {
            // Calculate end time
            const endTime = new Date().getTime() + (testTimeLimit * 60 * 1000);
            
            // Update timer every second
            const timerInterval = setInterval(function () {
                const now = new Date().getTime();
                const distance = endTime - now;
                const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);
                const timerElement = document.getElementById('timer');
                
                if (timerElement) {
                    timerElement.innerHTML = minutes + "m " + seconds + "s ";
                }
                
                // If the count down is over, leave the room
                if (distance < 0) {
                    document.getElementById('leaveroom')?.click();
                    document.getElementById('submitcode')?.click();
                    clearInterval(timerInterval);
                    if (timerElement) {
                        timerElement.innerHTML = "EXPIRED";
                    }
                }
            }, 1000);
        }
    </script>

    <script>
        // Ensure a single shared socket instance for the student page
        document.addEventListener('DOMContentLoaded', function () {
            const socket = window.socket || io();
            window.socket = socket;
            const adminPanel = document.getElementById('tabalert');

            // Socket connection event handlers
            socket.on('connect', () => {
                console.log('Connected to server');
            });

            socket.on('connect_error', (error) => {
                console.error('Connection error:', error);
                tata.error('Connection Error', 'Failed to connect to server', {
                    animate: 'fade',
                    position: 'tm'
                });
            });

            socket.on('disconnect', (reason) => {
                console.log('Disconnected:', reason);
                tata.warn('Disconnected', 'Lost connection to server', {
                    animate: 'fade',
                    position: 'tm'
                });
            });

            // Update the visibility change event listener
            socket.on('visibility-change', ({ username, roomId, action, url }) => {
                if (!username || !roomId || !action) {
                    console.error('Invalid visibility change data received');
                    return;
                }

                try {
                    // Create a new div element for the visibility change message
                    const visibilityChangeElement = document.createElement('div');
                    visibilityChangeElement.classList.add('visibility-change-message');

                    // Get the current time
                    const currentTime = new Date();
                    const formattedTime = currentTime.toLocaleTimeString();

                    // Set the content of the message with the timestamp
                    visibilityChangeElement.textContent = `[${formattedTime}] User ${username} in room ${roomId} ${action}`;

                    // Append the visibility change message to the admin panel if it exists
                    if (adminPanel) {
                        adminPanel.appendChild(visibilityChangeElement);
                        adminPanel.scrollTop = adminPanel.scrollHeight;
                    }
                } catch (error) {
                    console.error('Error updating visibility:', error);
                }
            });

        });


    </script>

    <script>
        let tabSwitchCount = 0;
        const MAX_TAB_SWITCHES = 7;
        
        document.addEventListener('visibilitychange', function () {
            try {
                if (!socket || !socket.connected) {
                    console.error('Socket not connected');
                    return;
                }

                if (document.visibilityState === 'hidden') {
                    // Page is hidden, notify admin and alert the user
                    socket.emit('page-visibility-change', {
                        state: 'hidden',
                        count: ++tabSwitchCount,
                        timestamp: new Date().toISOString()
                    });

                    tata.warn('Warning', 'Tab switch detected! This event has been logged.', {
                        animate: 'fade',
                        position: 'tm'
                    });

                    if (tabSwitchCount >= MAX_TAB_SWITCHES) {
                        const leaveButton = document.getElementById('leaveroom');
                        if (leaveButton) {
                            tata.error('Test Aborted', 'Maximum tab switches exceeded. Leaving room...', {
                                animate: 'fade',
                                position: 'tm'
                            });
                            leaveButton.click();
                        }
                    }
                } else {
                    // Page is visible again
                    socket.emit('page-visibility-change', {
                        state: 'visible',
                        count: tabSwitchCount,
                        timestamp: new Date().toISOString()
                    });
                }
            } catch (error) {
                console.error('Error in visibility change handler:', error);
            }
        });
    </script>

    <!-- Admin Activity Tracking Script -->
    <script>
        // Admin activity tracking
        let adminStatus = 'offline';
        let lastAdminActivity = null;

        // Update admin status badge
        function updateAdminStatus(status, message) {
            const badge = document.getElementById('adminStatusBadge');
            const statusText = document.getElementById('adminStatusText');
            
            if (badge && statusText) {
                // Remove all status classes
                badge.classList.remove('offline', 'online', 'watching', 'teaching');
                badge.classList.add(status);
                statusText.textContent = message;
                adminStatus = status;
            }
        }

        // Add activity to feed
        function addAdminActivity(message, type = '') {
            const feed = document.getElementById('adminActivityFeed');
            if (!feed) return;

            // Clear placeholder if exists
            const placeholder = feed.querySelector('[style*="italic"]');
            if (placeholder) {
                feed.innerHTML = '';
            }

            const activityItem = document.createElement('div');
            activityItem.className = 'admin-activity-item';
            if (type) activityItem.classList.add(type);

            const time = new Date().toLocaleTimeString('en-US', { 
                hour: '2-digit', 
                minute: '2-digit' 
            });

            activityItem.innerHTML = `
                ${message}
                <span class="activity-time">[${time}]</span>
            `;

            // Add to top of feed
            feed.insertBefore(activityItem, feed.firstChild);

            // Keep only last 10 activities
            while (feed.children.length > 10) {
                feed.removeChild(feed.lastChild);
            }

            // Auto scroll to top
            feed.scrollTop = 0;
        }

        // Show toast notification
        function showAdminNotification(title, message, type = 'info') {
            tata[type](title, message, {
                animate: 'fade',
                position: 'tr',
                duration: 4000
            });
        }

        // Apply visual feedback to editor
        function setEditorVisualFeedback(isActive, isTeaching = false) {
            const editorWrapper = document.querySelector('.CodeMirror');
            if (editorWrapper) {
                editorWrapper.classList.toggle('admin-active', isActive && !isTeaching);
                editorWrapper.classList.toggle('admin-teaching', isTeaching);
            }
        }

        // Listen for admin joining/leaving events
        if (typeof socket !== 'undefined') {
            // Admin joined the room
            socket.on('admin-joined', function(data) {
                updateAdminStatus('online', '👨‍🏫 Admin Online');
                addAdminActivity('🟢 Admin joined the room', 'admin-joined');
                showAdminNotification('Admin Online', 'Your teacher has joined the room', 'success');
                setEditorVisualFeedback(false);
            });

            // Admin left the room
            socket.on('admin-left', function(data) {
                updateAdminStatus('offline', 'Admin Offline');
                addAdminActivity('⚫ Admin left the room', 'admin-activity-item');
                showAdminNotification('Admin Offline', 'Your teacher has left the room', 'warn');
                setEditorVisualFeedback(false);
            });

            // Admin is viewing this student's code
            socket.on('admin-viewing-you', function(data) {
                updateAdminStatus('watching', '👀 Admin Watching You');
                addAdminActivity('👀 Admin is viewing your code', 'admin-watching');
                showAdminNotification('Admin Watching', 'Your teacher is viewing your code', 'info');
                setEditorVisualFeedback(true, false);
            });

            // Admin stopped viewing this student
            socket.on('admin-stopped-viewing', function(data) {
                updateAdminStatus('online', '👨‍🏫 Admin Online');
                setEditorVisualFeedback(false);
            });

            // Admin opened submissions/grading page
            socket.on('admin-grading', function(data) {
                addAdminActivity('📊 Admin opened submissions page', 'admin-grading');
                showAdminNotification('Grading Mode', 'Admin is reviewing all submissions', 'info');
            });
        }
    </script>
    

