                                        <p id="adminCamRequestText" style="margin:0 0 18px 0; font-size:14px; line-height:1.5; color:#333;">Your instructor is requesting to view your camera. Please choose whether to allow access.</p>
                                        <div style="display:flex; gap:12px; justify-content:flex-end;">
                                            <button id="adminCamDecline" class="btn btn-sm btn-danger" style="min-width:90px;">Decline</button>
                                            <button id="adminCamAccept" class="btn btn-sm btn-success" style="min-width:120px;">Allow Camera</button>
                                        </div>
