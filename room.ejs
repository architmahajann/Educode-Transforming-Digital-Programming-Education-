                                <!-- --inputs-- -->
                                <h4 class="input-title">Input</h4>
                                <textarea type="text" class="inputs" id='codeinput' value=''></textarea>
                            </div>
                            <hr>
                            <div class="output">
                                <h4 class="output-title">Output</h4>
                                <!-- --output-- -->
                                <div id="output"></div>
                            </div>
                        </div>
                        <hr>
                        <div class="stu-btns run-submit">
