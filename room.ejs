        <script>
            // Setup read-only CodeMirror for Admin Live Code
            (function(){
                try {
                    var adminLiveTA = document.getElementById('adminLiveCode');
                    if (!adminLiveTA) return;
                    window.adminLiveEditor = CodeMirror.fromTextArea(adminLiveTA, {
                        mode: 'text/x-c++src',
                        theme: 'dracula',
                        lineNumbers: true,
                        readOnly: 'nocursor',
                        lineWrapping: true,
                        foldGutter: true,
                        gutters: ['CodeMirror-linenumbers', 'CodeMirror-foldgutter']
                    });
                    window.adminLiveEditor.setSize('100%', '200px');
                } catch (e) {
                    console.error('Failed to initialize admin live editor:', e);
                }
            })();
        </script>
        <script>
            // Listen for admin live code broadcast
            (function(){
                if (typeof socket === 'undefined') return;
                const status = document.getElementById('adminLiveStatus');
                const editorWrapper = document.getElementById('adminLiveEditorWrapper');
                const placeholder = document.getElementById('adminLivePlaceholder');
                let applying = false;

                function showLiveEditor() {
                    if (editorWrapper) editorWrapper.style.display = 'block';
                    if (placeholder) placeholder.style.display = 'none';
                    if (status) {
                        status.textContent = 'Sharing ●';
                        status.style.color = '#28a745';
                        status.style.fontWeight = 'bold';
                    }
                }

                function hideLiveEditor() {
                    if (editorWrapper) editorWrapper.style.display = 'none';
                    if (placeholder) placeholder.style.display = 'block';
                    if (status) {
                        status.textContent = 'Not sharing';
                        status.style.color = '#888';
                        status.style.fontWeight = 'normal';
                    }
                }

                socket.on('admin-live-code-full', ({ code }) => {
                    try {
                        if (!window.adminLiveEditor) return;
                        applying = true;
                        window.adminLiveEditor.setValue(code || '');
                        applying = false;
                        showLiveEditor();
                        addAdminActivity && addAdminActivity('📡 Admin started sharing editor', 'admin-teaching');
                        if (typeof showAdminNotification === 'function') {
                            showAdminNotification('Code Sharing', 'Admin is now sharing their code', 'info');
                        }
                    } catch (e) { console.error('Error applying admin full code:', e); }
                });

                socket.on('admin-live-code-change', ({ changeObj }) => {
                    try {
                        if (!window.adminLiveEditor || !changeObj) return;
                        if (!Array.isArray(changeObj.text)) return;
                        applying = true;
                        window.adminLiveEditor.replaceRange(changeObj.text, changeObj.from, changeObj.to, 'admin-live');
                        applying = false;
                        showLiveEditor();
                    } catch (e) { console.error('Error applying admin live change:', e); }
                });

                // Listen for broadcast toggle off (we can infer this if no changes for a while, or add explicit event)
                // For now, the editor stays visible once shared
            })();
        </script>
        <script>
            // Student: Admin AV (WebRTC) viewer
            (function(){
                const socket = window.socket || io();
                window.socket = socket;
                const videoEl = document.getElementById('adminAV');
                const unmuteBtn = document.getElementById('adminAVUnmute');
                const statusEl = document.getElementById('adminAVStatus');
                const containerEl = document.getElementById('adminAVContainer');
                const placeholderEl = document.getElementById('adminAVPlaceholder');
                const urlParts = new URL(window.location.href);
                const pathParts = urlParts.pathname.split('/');
                const roomId = pathParts[pathParts.indexOf('joined') + 1];
                let pc = null;
                let lastOfferFrom = null;
                const pendingIce = [];
                
                // ICE servers from server-side env (supports TURN when provided)
                const ICE_SERVERS = (function(){
                    try { return JSON.parse('<%- JSON.stringify(WEBRTC_ICE_SERVERS || []) %>'); }
                    catch(_) { return [{ urls: ['stun:stun.l.google.com:19302'] }]; }
                })();

                console.log('[AV] Student viewer initialized for room:', roomId);

                function setLiveUI(live){
                    if (statusEl) {
                        statusEl.textContent = live ? 'Live ●' : 'Not live';
                        statusEl.style.color = live ? '#28a745' : '#888';
                        statusEl.style.fontWeight = live ? 'bold' : 'normal';
                    }
                    if (containerEl) containerEl.style.display = live ? 'block' : 'none';
                    if (placeholderEl) placeholderEl.style.display = live ? 'none' : 'block';
                }

                function cleanup(){
                    console.log('[AV] Cleaning up connection');
                    try { if (pc) pc.close(); } catch(_){}
                    pc = null;
                    lastOfferFrom = null;
                    pendingIce.length = 0;
                    if (videoEl && videoEl.srcObject){
                        try { videoEl.srcObject.getTracks().forEach(t => t.stop()); } catch(_){}
                        videoEl.srcObject = null;
                    }
                    setLiveUI(false);
                }

                async function initViewer(){
                    try{
                        if (pc) {
                            console.log('[AV] Peer connection already exists');
                            return;
                        }
                        console.log('[AV] Creating new peer connection with ICE servers:', ICE_SERVERS);
                        pc = new RTCPeerConnection({ iceServers: ICE_SERVERS });
                        
                        pc.onicecandidate = (ev) => {
                            if (ev.candidate){
                                console.log('[AV] Generated ICE candidate');
                                if (lastOfferFrom) {
                                    socket.emit('webrtc-ice-candidate', { targetSocketId: lastOfferFrom, candidate: ev.candidate });
                                } else {
                                    console.log('[AV] Queueing ICE candidate (no offer yet)');
                                    pendingIce.push(ev.candidate);
                                }
                            } else {
                                console.log('[AV] ICE gathering complete');
                            }
                        };
                        
                        pc.ontrack = (ev) => {
                            console.log('[AV] Received track:', ev.track.kind, 'streams:', ev.streams.length);
                            if (videoEl && ev.streams && ev.streams[0]){
                                videoEl.srcObject = ev.streams[0];
                                console.log('[AV] Attached stream to video element');
                                // Try to autoplay (will be muted initially)
                                videoEl.play().then(() => {
                                    console.log('[AV] Video playing (muted)');
                                    if (unmuteBtn) unmuteBtn.style.display = 'block';
                                }).catch(err => {
                                    console.warn('[AV] Autoplay failed:', err);
                                    if (unmuteBtn) unmuteBtn.style.display = 'block';
                                });
                            }
                        };
                        
                        pc.onconnectionstatechange = () => {
                            console.log('[AV] Connection state:', pc.connectionState);
                            if (pc.connectionState === 'failed' || pc.connectionState === 'closed') {
                                cleanup();
                            }
                        };

                        pc.oniceconnectionstatechange = () => {
                            console.log('[AV] ICE connection state:', pc.iceConnectionState);
                        };
                        
                        // Tell admin we are ready
                        console.log('[AV] Emitting viewer-ready');
                        socket.emit('viewer-ready', { roomId, username });
                    } catch(err){ 
                        console.error('[AV] initViewer failed:', err); 
                    }
                }

                socket.on('admin-av-started', ({ roomId: r }) => {
                    console.log('[AV] Admin started broadcasting in room:', r);
                    setLiveUI(true);
                    if (typeof addAdminActivity === 'function') {
                        addAdminActivity('📹 Admin started camera/mic', 'admin-teaching');
                    }
                    if (typeof showAdminNotification === 'function') {
                        showAdminNotification('Live Stream', 'Admin camera is now live', 'info');
                    }
                    initViewer();
                });
                
                socket.on('admin-av-stopped', ({ roomId: r }) => {
                    console.log('[AV] Admin stopped broadcasting in room:', r);
                    if (typeof addAdminActivity === 'function') {
                        addAdminActivity('📹 Admin stopped camera/mic', 'admin-activity-item');
                    }
                    cleanup();
                });

                socket.on('webrtc-offer', async ({ from, sdp }) => {
                    console.log('[AV] Received offer from:', from);
                    try{
                        lastOfferFrom = from;
                        if (!pc) await initViewer();
                        
                        console.log('[AV] Setting remote description');
                        await pc.setRemoteDescription(new RTCSessionDescription(sdp));
                        
                        console.log('[AV] Creating answer');
                        const answer = await pc.createAnswer();
                        await pc.setLocalDescription(answer);
                        
                        console.log('[AV] Sending answer to admin');
                        socket.emit('webrtc-answer', { targetSocketId: from, sdp: pc.localDescription });
                        
                        // Flush queued ICE candidates
                        console.log('[AV] Flushing', pendingIce.length, 'queued ICE candidates');
                        while (pendingIce.length) {
                            const c = pendingIce.shift();
                            socket.emit('webrtc-ice-candidate', { targetSocketId: from, candidate: c });
                        }
                        
                        setLiveUI(true);
                    } catch(err){ 
                        console.error('[AV] Failed to handle offer:', err); 
                    }
                });

                socket.on('webrtc-ice-candidate', async ({ from, candidate }) => {
                    console.log('[AV] Received ICE candidate from admin');
                    try{
                        if (!pc) {
                            console.warn('[AV] No peer connection yet, cannot add ICE');
                            return;
                        }
                        if (!candidate) return;
                        await pc.addIceCandidate(new RTCIceCandidate(candidate));
                        console.log('[AV] Added ICE candidate');
                    } catch(err){ 
                        console.error('[AV] Failed to add ICE candidate:', err); 
                    }
                });
                
                // Unmute button handler
                if (unmuteBtn && videoEl) {
                    unmuteBtn.addEventListener('click', async () => {
                        console.log('[AV] Unmute button clicked');
                        try {
                            videoEl.muted = false;
                            await videoEl.play();
                            unmuteBtn.style.display = 'none';
                            console.log('[AV] Audio unmuted and playing');
                            if (typeof tata !== 'undefined') {
                                tata.success('Audio Enabled', 'You can now hear the admin');
                            }
                        } catch (e) {
                            console.error('[AV] Failed to unmute:', e);
                            if (typeof tata !== 'undefined') {
                                tata.error('Audio Error', 'Failed to enable audio');
                            }
                        }
                    });
                }
            })();
        </script>
        <script>
            // Listen for allotted question updates from admin
            (function(){
                if (typeof socket === 'undefined') return;
                const container = document.getElementById('allottedQuestionContainer');
                function escapeHtml(s){ return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
                function renderQuestions(questions){
                    if (!container) return;
                    if (Array.isArray(questions) && questions.length > 0){
                        const parts = [];
                        questions.forEach((q) => {
                            const raw = encodeURIComponent(String(q||''));
                            parts.push(`<div class=\"allotted-block\" data-raw=\"${raw}\" style=\"position:relative; padding-top:4px; margin-bottom:12px;\">`);
                            parts.push(`<button type=\"button\" class=\"copy-btn\" title=\"Copy\" style=\"position:absolute; top:0; right:0; border:none; background:#f1f5ff; color:#007bff; padding:4px 8px; border-radius:4px; cursor:pointer; font-size:12px;\">Copy</button>`);
                            parts.push(`<pre style=\"font-size: 14px; line-height: 1.6; color: #333; white-space: pre-wrap; word-wrap: break-word; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; border-top: 1px solid #eee; padding-top:8px;\">${escapeHtml(String(q||''))}</pre>`);
                            parts.push(`</div>`);
                        });
                        container.innerHTML = parts.join('');
                    } else {
                        container.innerHTML = '<p style="color: #888; font-style: italic; margin: 0;">No question assigned yet.</p>';
                    }
                }
                socket.on('allotted-question-updated', ({ question }) => {
                    renderQuestions([question]);
                });
                socket.on('allotted-questions-updated', ({ questions }) => {
                    renderQuestions(questions);
                });

                // Copy button handler (event delegation)
                container.addEventListener('click', async (e) => {
                    const btn = e.target.closest('.copy-btn');
                    if (!btn) return;
                    const block = btn.closest('.allotted-block');
                    if (!block) return;
                    try {
                        const raw = block.getAttribute('data-raw') || '';
                        const text = decodeURIComponent(raw);
                        if (navigator.clipboard && navigator.clipboard.writeText) {
                            await navigator.clipboard.writeText(text);
                        } else {
                            // Fallback
                            const ta = document.createElement('textarea');
                            ta.value = text;
                            document.body.appendChild(ta);
                            ta.select();
                            document.execCommand('copy');
                            document.body.removeChild(ta);
                        }
                        try { tata.success('Copied', 'Question copied to clipboard'); } catch (_) {}
                    } catch (err) {
                        console.error('Copy failed', err);
                        try { tata.error('Copy failed'); } catch (_) {}
                    }
                });
            })();
        </script>
