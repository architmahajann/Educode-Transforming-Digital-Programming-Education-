<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head', {page: 'Home', menuId: 'home'}) %>
</head>

<body style="overflow: hidden;">

    <img style="position: absolute; left: 600px;" class="wave" src="images/bg3.svg">
    <div style="position: relative; right: 830px; width: 200vw;" class="container">
        <div class="img1">
            <img src="images/bg1.png">
        </div>
        <div class="login-content">
            <div style="margin-top: 40px;" class="header"><span> Educode </span></div>
            <div style="color: whitesmoke; line-height:25px; font-size: 24px; font-weight: 300; padding-top: 30;" class="subheader"><span> Transforming-Digital-Programming-Education </span></div>
            <!-- <form> -->
            <img src="images/avatar.svg">
            <h2 class="title">Welcome to Educode</h2>
            <div class="btns">
                <a href="./create"><button class="btn">Create Room (Teacher)</button></a>
                <button class="btn" id="joinRoomBtn" onclick="showJoinRoomPrompt()">Join Room (Student)</button>
            </div>
        </div>
    </div>
    <footer style="position: fixed; bottom: 0; width: 100%; background-color: #1a1a1a; color: white; text-align: center; padding: 5px;">
        &copy; Archit Mahajan And Team
    </footer>

    <script>
        function showJoinRoomPrompt() {
            const input = prompt('Paste the full room link OR just the Room ID:');
            if (!input || input.trim() === '') return;
            
            let roomId = input.trim();
            
            // If user pasted full URL, extract just the room ID
            if (roomId.includes('/room/join/')) {
                roomId = roomId.split('/room/join/').pop();
            } else if (roomId.includes('http')) {
                // Try to extract last segment if it's any URL
                const parts = roomId.split('/').filter(p => p);
                roomId = parts[parts.length - 1];
            }
            
            // Remove any trailing slashes or whitespace
            roomId = roomId.replace(/\/$/, '').trim();
            
            if (roomId && roomId.length > 10) {
                window.location.href = '/room/join/' + roomId;
            } else {
                alert('Invalid Room ID. Please try again.');
            }
        }
    </script>

</body>

</html>
